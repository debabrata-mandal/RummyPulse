rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isGameCreator(gameId) {
      return isAuthenticated()
          && get(/databases/$(database)/documents/games_v2/$(gameId)).data.creatorUserId == request.auth.uid;
    }

    function isAdmin() {
      return isAuthenticated()
          && exists(/databases/$(database)/documents/appUser_v2/$(request.auth.uid))
          && get(/databases/$(database)/documents/appUser_v2/$(request.auth.uid)).data.role == 'admin_user';
    }

    function isActiveEditor(gameId) {
      return isAuthenticated()
          && get(/databases/$(database)/documents/games_v2/$(gameId)).data.activeEditorUserId == request.auth.uid;
    }

    function approvalDocId(gameId) {
      return gameId + '_' + request.auth.uid;
    }

    function hasApprovedViewAccess(gameId) {
      let docPath = /databases/$(database)/documents/gameViewApprovals_v2/$(approvalDocId(gameId));
      return exists(docPath)
          && get(docPath).data.status == 'approved';
    }

    function canManageViewApprovals(gameId) {
      return isAdmin() || isActiveEditor(gameId);
    }

    function gamePinGeneration(gameId) {
      let game = get(/databases/$(database)/documents/games_v2/$(gameId)).data;
      return game.keys().hasAll(['pinGeneration']) ? game.pinGeneration : 1;
    }

    function validEditGeneration(gameId) {
      return request.resource.data.keys().hasAll(['editGeneration'])
          && request.resource.data.editGeneration == gamePinGeneration(gameId);
    }

    function isAtomicEditGenerationTransfer(gameId) {
      let gameBefore = get(/databases/$(database)/documents/games_v2/$(gameId)).data;
      let gameAfter = getAfter(/databases/$(database)/documents/games_v2/$(gameId)).data;
      let previousGeneration = gameBefore.keys().hasAll(['pinGeneration'])
          ? gameBefore.pinGeneration
          : 1;
      return isAuthenticated()
          && gameBefore.activeEditorUserId == request.auth.uid
          && gameAfter.pinGeneration == previousGeneration + 1
          && !gameAfter.keys().hasAll(['activeEditorUserId'])
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['editGeneration'])
          && request.resource.data.editGeneration == gameAfter.pinGeneration;
    }

    function isAdminGameMetadataUpdate() {
      return isAdmin()
          && resource.data.keys().hasAll(['data'])
          && request.resource.data.keys().hasAll(['data'])
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['data', 'lastUpdated', 'editGeneration', 'version', 'revision'])
          && request.resource.data.data.diff(resource.data.data).affectedKeys()
              .hasOnly(['gamePointFactor', 'boardAdjustmentPercent', 'gameStatus'])
          && (
            (!resource.data.keys().hasAll(['revision'])
                && request.resource.data.revision == 1)
            || (resource.data.keys().hasAll(['revision'])
                && request.resource.data.revision == resource.data.revision + 1)
          );
    }

    function canCreateGameData(gameId) {
      return (isGameCreator(gameId) || isActiveEditor(gameId) || isAdmin())
          && validGameDataSchema(request.resource.data.data)
          && (!request.resource.data.keys().hasAll(['editGeneration'])
              || request.resource.data.editGeneration == gamePinGeneration(gameId));
    }

    function canUpdateGameData(gameId) {
      return (isActiveEditor(gameId)
              && validEditGeneration(gameId)
              && preservesStableGameSchema()
              && (
                (!resource.data.keys().hasAll(['revision'])
                    && request.resource.data.revision == 1)
                || (resource.data.keys().hasAll(['revision'])
                    && request.resource.data.revision == resource.data.revision + 1)
              ))
          || isAdminGameMetadataUpdate()
          || isAtomicEditGenerationTransfer(gameId);
    }

    function preservesStableGameSchema() {
      let oldData = resource.data.data;
      let newData = request.resource.data.data;
      return validGameDataSchema(oldData) && validGameDataSchema(newData);
    }

    function hasNoDeprecatedGamePointKeys(data) {
      return !data.keys().hasAny([
        'pointValue', 'gstPercent', 'gstAmount', 'grossAmount', 'netAmount',
        'gstPaid', 'contributionPaid', 'totalContribution', 'totalGstCollected',
        'defaultPointValue', 'defaultGstPercent', 'dashboardPointValue',
        'dashboardGstPercent', 'displayIntermediateCalculation',
        'showDashboardLeaderboardAmounts', 'pointValueReports', 'statsApplied'
      ]);
    }

    function hasNoStoredGameIdentityNames(data) {
      return !data.keys().hasAny(['creatorName', 'activeEditorName', 'lastEditorName']);
    }

    function validGameDataSchema(data) {
      return data.keys().hasAll([
          'schemaVersion', 'gamePointFactor', 'boardAdjustmentPercent',
          'playersById', 'playerOrder'
        ])
        && data.schemaVersion == 3
        && data.gamePointFactor is number
        && data.boardAdjustmentPercent is number
        && data.playersById is map
        && data.playerOrder is list
        && hasNoDeprecatedGamePointKeys(data);
    }

    match /games_v2/{gameId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
          && request.resource.data.creatorUserId == request.auth.uid
          && hasNoStoredGameIdentityNames(request.resource.data)
          && hasNoDeprecatedGamePointKeys(request.resource.data);
      allow update: if isAuthenticated()
          && hasNoStoredGameIdentityNames(request.resource.data)
          && hasNoDeprecatedGamePointKeys(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /gameData_v2/{gameId} {
      allow read: if isAuthenticated() && (
        isAdmin()
        || isGameCreator(gameId)
        || isActiveEditor(gameId)
        || hasApprovedViewAccess(gameId)
      );
      allow create: if canCreateGameData(gameId);
      allow update: if isAuthenticated() && canUpdateGameData(gameId);
      allow delete: if isGameCreator(gameId) || isAdmin();
    }

    match /gameScoreHistory_v2/{gameId}/rounds/{roundId}/events/{eventId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isGameCreator(gameId) || isActiveEditor(gameId)
      );
      allow create: if isActiveEditor(gameId)
          && eventId == request.resource.data.operationId
          && request.resource.data.gameId == gameId
          && request.resource.data.schemaVersion == 1
          && request.resource.data.editorUserId == request.auth.uid
          && request.resource.data.editGeneration == gamePinGeneration(gameId)
          && request.resource.data.scoresByPlayerId is map
          && request.resource.data.previousRevision + 1
              == request.resource.data.committedRevision
          && getAfter(/databases/$(database)/documents/gameData_v2/$(gameId))
              .data.revision == request.resource.data.committedRevision;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /gameViewApprovals_v2/{approvalId} {
      allow read: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/gameViewApprovals_v2/$(approvalId))
        || resource.data.userId == request.auth.uid
        || canManageViewApprovals(resource.data.gameId)
      );
      allow create: if isAuthenticated()
          && request.resource.data.keys().hasOnly([
            'gameId', 'userId', 'status', 'requestedAt', 'lastUpdatedAt'
          ])
          && approvalId == request.resource.data.gameId + '_' + request.resource.data.userId
          && (
            (
              request.resource.data.userId == request.auth.uid
              && request.resource.data.status == 'requested'
            )
            || (
              request.resource.data.status == 'approved'
              && (
                isGameCreator(request.resource.data.gameId)
                || canManageViewApprovals(request.resource.data.gameId)
              )
            )
          );
      allow update: if isAuthenticated()
          && canManageViewApprovals(resource.data.gameId)
          && request.resource.data.keys().hasOnly([
            'gameId', 'userId', 'status', 'requestedAt', 'lastUpdatedAt'
          ])
          && request.resource.data.gameId == resource.data.gameId
          && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated();
    }

    match /approvedGames_v2/{gameId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
          && request.resource.data.schemaVersion == 3
          && request.resource.data.gamePointFactor is number
          && request.resource.data.boardAdjustmentPercent is number
          && request.resource.data.boardPoints is number
          && hasNoDeprecatedGamePointKeys(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /appUser_v2/{userId} {
      allow read: if isAuthenticated();
      // Profile/identity creation is performed by App Check-protected callable functions.
      allow create: if false;
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['safePlayPolicyVersion', 'safePlayAcceptedAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['role', 'hidden']))
      );
      // Account deletion must use the App Check-protected callable functions so Firebase Auth
      // and associated account data are cleaned consistently. Admin SDK writes bypass these rules.
      allow delete: if false;
    }

    match /appUserIdentity_v1/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /profileNameClaims_v1/{nameKey} {
      allow read, write: if false;
    }

    match /gameDefaults_v2/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
          && request.resource.data.schemaVersion == 3
          && request.resource.data.defaultGamePointFactor is number
          && request.resource.data.defaultBoardAdjustmentPercent is number
          && hasNoDeprecatedGamePointKeys(request.resource.data);
    }

    match /approvedGamesReport_v2/{monthDoc} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
          && request.resource.data.schemaVersion == 3
          && request.resource.data.gamePointFactorReports is list
          && hasNoDeprecatedGamePointKeys(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // Pre-aggregated dashboard performance. The editor who completes a game records stats for
    // every mapped player, so writes are not restricted to the owning user - the same posture
    // already used by games_v2 and approvedGames_v2.
    match /playerStats_v2/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
          && request.resource.data.schemaVersion == 3
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'userId', 'allTime', 'months', 'weeks', 'updatedAt'
          ])
          && hasNoDeprecatedGamePointKeys(request.resource.data)
          && hasNoDeprecatedGamePointKeys(request.resource.data.allTime);
      allow delete: if isAuthenticated();
    }
  }
}
