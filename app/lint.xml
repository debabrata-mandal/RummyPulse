<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- UI chrome (badges, chart labels) uses dp text sizes intentionally. -->
    <issue id="SpUsage" severity="ignore" />

    <!-- Glide 5.x requires compileSdk 37; stay on 4.16.0 with compileSdk 34. -->
    <issue id="NewerVersionAvailable">
        <ignore regexp="glide" />
    </issue>

    <!-- compileSdk 34: newer androidx/work/navigation/firebase versions require compileSdk 35+. -->
    <issue id="GradleDependency" severity="ignore" />

    <!-- Gradle catalog migration is out of scope for a lint cleanup pass. -->
    <issue id="UseTomlInstead" severity="ignore" />

    <!-- Large game screens are intentionally dense; refactoring for view count is separate work. -->
    <issue id="TooManyViews" severity="ignore" />

    <!-- Referenced from themes.xml; lint does not trace style item backgrounds. -->
    <issue id="UnusedResources">
        <ignore regexp="status_indicator_online" />
        <ignore regexp="StatusIndicator" />
    </issue>

    <!-- Overlay error/content panels require a root FrameLayout. -->
    <issue id="MergeRootFrame" severity="ignore" />

    <!-- targetSdk 34 is intentional for minSdk-24 device support. -->
    <issue id="OldTargetApi" severity="ignore" />

    <!-- AGP upgrades are validated separately from lint cleanup. -->
    <issue id="AndroidGradlePluginVersion" severity="ignore" />

    <!-- Guard is required below API 31; lint misreads call site reachability. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/java/com/example/rummypulse/utils/ModernUpdateChecker.java" />
    </issue>
</lint>
