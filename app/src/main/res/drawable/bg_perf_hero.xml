<?xml version="1.0" encoding="utf-8"?>
<!-- Performance hero surface: deep plasma gradient with a translucent accent edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="300"
        android:startColor="#FF07060F"
        android:centerColor="#FF14102A"
        android:endColor="#FF241A4D"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#4D8C52FF" />
</shape>
