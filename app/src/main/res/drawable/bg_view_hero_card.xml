<?xml version="1.0" encoding="utf-8"?>
<!--
  Header surface. Near-flat and low in chroma so the balance figure, not the container, is what
  the eye lands on first. Kept separate from bg_view_hero, which the dialogs still share.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient android:angle="270" android:startColor="#FF181530" android:endColor="#FF110F1F" />
    <stroke android:width="1dp" android:color="#3D7E67E8" />
</shape>
