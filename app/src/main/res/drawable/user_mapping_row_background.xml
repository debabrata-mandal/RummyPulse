<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#337357F6" />
            <stroke android:width="1dp" android:color="#66A895FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/view_surface" />
            <stroke android:width="1dp" android:color="@color/view_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
