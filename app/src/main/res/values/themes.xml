<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Financial App Theme -->
    <style name="Theme.RummyPulse" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_blue_light</item>
        <item name="colorSecondaryVariant">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_blue_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@color/primary_blue_dark</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="alertDialogTheme">@style/DarkAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/DarkAlertDialog</item>
        <item name="popupMenuStyle">@style/DarkPopupMenuStyle</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.RummyPulse.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.RummyPulse.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.RummyPulse.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />

    <style name="NavigationSectionText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/navigation_section_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TableRowTextSecondary">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="StatusIndicator">
        <item name="android:layout_width">8dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/status_indicator_online</item>
    </style>

    <!-- Market Overview Styles -->
    <style name="MarketOverviewTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Dark Dialog Theme -->
    <style name="DarkDialogTheme" parent="Theme.MaterialComponents.Dialog">
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="android:windowBackground">@drawable/bg_app_surface_blue</item>
    </style>

    <!-- Dark Popup Menu Theme -->
    <style name="DarkPopupMenuStyle" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_app_surface_blue</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="ThemeOverlay.RummyPulse.ViewPopup" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="android:colorBackground">@color/view_surface_soft</item>
        <item name="colorSurface">@color/view_surface_soft</item>
        <item name="colorOnSurface">@color/view_text_primary</item>
        <item name="android:textColorPrimary">@color/view_text_primary</item>
        <item name="android:textColorSecondary">@color/view_text_secondary</item>
        <item name="popupMenuStyle">@style/ViewModePopupMenuStyle</item>
    </style>

    <style name="ViewModePopupMenuStyle" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_view_popup_menu</item>
        <item name="android:textColor">@color/view_text_primary</item>
        <item name="android:textColorPrimary">@color/view_text_primary</item>
    </style>

    <!-- Dark Alert Dialog Theme -->
    <style name="DarkAlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:colorBackground">@color/card_background</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="android:windowBackground">@drawable/bg_app_surface_blue</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TableRowTextSecondary</item>
    </style>
</resources>
