    <!-- Race chart. The grid is two weights: rounds played, and rounds still to come. -->
    <color name="race_grid">#FF1C1A35</color>
    <color name="race_grid_future">#FF14121F</color>
    <!--
      One colour per player line. Categorical, not semantic: these say which player, never how they
      are doing. Picked to stay apart on a near-black surface, and reused in order by seat so a
      player keeps the same line between updates.
    -->
    <color name="race_line_1">#FF8C52FF</color>
    <color name="race_line_2">#FFC44FD4</color>
    <color name="race_line_3">#FF5A9BD4</color>
    <color name="race_line_4">#FF4AB58A</color>
    <color name="race_line_5">#FFE8A33D</color>
    <color name="race_line_6">#FFE06C8B</color>
    <color name="race_line_7">#FF6FC3C8</color>
    <color name="race_line_8">#FFB0A04A</color>
    <color name="view_violet_light">#FFB47EFF</color>
    <!-- Round progress ramp: the opening rounds are blue, the middle warms to yellow, the last
         run to red. Cyan rather than the card's own violet, which the segments disappeared
         into; it is also the one bright hue not already spoken for by points, balances or
         connectivity, so it cannot be misread as a score. -->
    <color name="round_progress_cyan">#FF00E5FF</color>
    <color name="round_complete_green">#FF3DDC97</color>
    <!-- Rounds not yet reached. Neutral grey rather than a dimmed band colour, so colour on this
         bar only ever means "this round has happened" and off-rounds cannot be misread as on. -->
    <color name="round_segment_track">#30FFFFFF</color>
    <!-- Donut slices. Four separate hues rather than shades, so neighbouring arcs never blend:
         cool colours mark winners, warm colours mark losers. -->
    <color name="leaderboard_slice_win_1">#FF00E676</color>
    <color name="leaderboard_slice_win_2">#FF00B0FF</color>
    <color name="leaderboard_slice_loss_1">#FFFFAB00</color>
    <color name="leaderboard_slice_loss_2">#FFFF1744</color>
    <color name="view_mint">#FF00E676</color>
    <color name="view_gold">#FFFFD600</color>
    <color name="view_coral">#FFFF1744</color>

    <!-- Player ranking medals. Gold reuses view_gold. -->
    <color name="ranking_medal_silver">#FFC6CEDB</color>
    <color name="ranking_medal_bronze">#FFCE8946</color>
