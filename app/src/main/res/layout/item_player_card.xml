<?xml version="1.0" encoding="utf-8"?>
<!--
  One player as a leaderboard row rather than a form.

  Rank leads, because the list exists to show an order and the rank used to be the smallest thing
  on it. The bar under the name is this player's total against the highest total in the game, so
  the gaps between players are visible without reading every number.

  At rest the row carries only what you read: rank, who, how far behind, total, net GP. The chevron
  opens the round detail and the two actions, which keeps a destructive Remove off a row you scroll
  past constantly. Tapping the row itself still opens the round-score sheet and the avatar still
  opens the player-mapping dialog, so neither gesture changes meaning.

  Every figure here is derived from game data already in memory - nothing on this row costs a read.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_view_player_row"
    android:elevation="0dp"
    android:importantForAutofill="no"
    android:orientation="horizontal">

    <View
        android:id="@+id/player_role_stripe"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/view_text_muted"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="10dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_player_position"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/view_text_primary"
                android:textSize="18sp"
                tools:text="3" />

            <TextView
                android:id="@+id/player_rank_movement"
                android:layout_width="13dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/view_text_muted"
                android:textSize="9sp"
                tools:text="▼" />

            <FrameLayout
                android:id="@+id/btn_map_player"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="3dp"
                android:clickable="true"
                android:contentDescription="@string/map_player_icon_description"
                android:focusable="true">

                <ImageView
                    android:id="@+id/player_avatar_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/dashboard_avatar_description"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/player_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_view_avatar"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/view_violet_light"
                    android:textSize="12sp"
                    tools:text="AD" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/text_player_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:ellipsize="end"
                        android:hint="@string/tap_to_enter_name_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:paddingStart="0dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="0dp"
                        android:saveEnabled="false"
                        android:selectAllOnFocus="true"
                        android:textColor="@color/view_text_primary"
                        android:textColorHint="@color/view_text_muted"
                        android:textSize="14sp"
                        tools:text="Amit D" />

                    <TextView
                        android:id="@+id/text_player_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/view_text_muted"
                        android:textSize="10sp"
                        android:visibility="gone"
                        tools:text="#33" />

                    <TextView
                        android:id="@+id/text_player_pending_sync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:letterSpacing="0.1"
                        android:text="@string/player_change_pending_sync"
                        android:textAllCaps="true"
                        android:textColor="@color/view_gold"
                        android:textSize="9sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Gap to the worst total in the game. Fill weight is set at bind time. -->
                <LinearLayout
                    android:id="@+id/player_gap_track"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_player_gap_track"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <View
                        android:id="@+id/player_gap_fill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.4"
                        android:background="@drawable/bg_player_gap_fill" />

                    <View
                        android:id="@+id/player_gap_remainder"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.6" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/text_player_total_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/view_gold"
                android:textSize="17sp"
                tools:text="229" />

            <TextView
                android:id="@+id/text_final_game_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="50dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/view_text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="-18 GP" />

            <ImageView
                android:id="@+id/drag_handle"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/cd_drag_to_reorder"
                android:focusable="true"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_drag_handle"
                android:visibility="gone"
                app:tint="@color/view_text_muted" />

        </LinearLayout>

        <!--
          Opened by tapping the row. No chevron: the row is the control, and an icon whose only job
          is to duplicate the row's own tap adds a target without adding a choice.
        -->
        <LinearLayout
            android:id="@+id/player_card_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">
            <!--
              The rounds, drawn as the same tiles the rest of the app uses for a round score, so a
              score looks the same wherever you meet it. Built only for the open card.
            -->
            <LinearLayout
                android:id="@+id/player_card_round_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />


            <!-- Hand counts, each under its own caption. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:maxLines="1" android:text="@string/view_header_label_made" android:textAllCaps="true" android:textColor="@color/view_text_muted" android:textSize="9sp" />
                    <TextView android:id="@+id/text_player_made_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/view_mint" android:textSize="15sp" tools:text="3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:maxLines="1" android:text="@string/view_header_label_packed" android:textAllCaps="true" android:textColor="@color/view_text_muted" android:textSize="9sp" />
                    <TextView android:id="@+id/text_player_packed_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/view_gold" android:textSize="15sp" tools:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:maxLines="1" android:text="@string/view_header_label_full_hand" android:textAllCaps="true" android:textColor="@color/view_text_muted" android:textSize="9sp" />
                    <TextView android:id="@+id/text_player_full_hand_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/view_coral" android:textSize="15sp" tools:text="2" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
