<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_view_hero"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_view_pin_icon"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_link_players"
            android:tint="@color/view_violet_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map_player_transfer_title"
                android:textColor="@color/view_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/map_player_transfer_subtitle"
                android:textColor="@color/view_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#38111424"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/view_stroke"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/text_transfer_mapping_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_info"
            android:drawablePadding="10dp"
            android:drawableTint="@color/view_violet_light"
            android:gravity="center_vertical"
            android:lineSpacingExtra="2dp"
            android:padding="14dp"
            android:textColor="@color/view_text_secondary"
            android:textSize="13sp" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_transfer_mapping_cancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/dialog_cancel"
            android:textAllCaps="false"
            android:textColor="@color/view_text_primary"
            app:backgroundTint="#24111424"
            app:cornerRadius="10dp"
            app:strokeColor="@color/view_violet_light"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_transfer_mapping_confirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/map_player_transfer_confirm"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/view_violet"
            app:cornerRadius="10dp" />

    </LinearLayout>

</LinearLayout>
