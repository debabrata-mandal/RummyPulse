<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_view_mode_screen"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

            <!-- View mode has its own app bar and never exposes edit-mode chrome. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/view_mode_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="13dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/view_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/view_mode_game_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Friday Night Rummy"
                        android:textColor="@color/view_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/view_mode_game_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="GAME · FNKV66TSI"
                        android:textColor="@color/view_text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/view_mode_qr"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_view_action"
                    android:contentDescription="Show QR code"
                    android:padding="11dp"
                    android:src="@drawable/ic_qr_code"
                    android:tint="@color/view_text_primary" />

                <ImageButton
                    android:id="@+id/view_mode_overflow"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More options"
                    android:padding="11dp"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/view_text_primary" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/view_mode_fixed_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <!-- Settlement hero -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_view_hero"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/view_mode_settlement_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="Player Performance"
                                    android:textColor="@color/view_text_primary"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    app:autoSizeMaxTextSize="18sp"
                                    app:autoSizeMinTextSize="11sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="164dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/view_mode_round_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Live · Round 4 of 10"
                                    android:textColor="@color/view_text_secondary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <ProgressBar
                                    android:id="@+id/view_mode_round_progress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:layout_marginTop="4dp"
                                    android:max="10"
                                    android:progress="3"
                                    android:progressBackgroundTint="#33475A78"
                                    android:progressTint="@color/view_violet_light" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_view_metric"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="8dp">
                                <TextView android:id="@+id/view_mode_balance_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Balance" android:textColor="@color/view_text_muted" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/view_mode_player_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="+₹379" android:textColor="@color/view_mint" android:textSize="15sp" android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_view_metric"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="8dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Position" android:textColor="@color/view_text_muted" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/view_mode_player_position" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="#3 of 8" android:textColor="@color/view_violet_light" android:textSize="15sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_view_metric"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="7dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="Made Game" android:textColor="@color/view_text_muted" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/view_mode_made_game_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="0" android:textColor="@color/view_mint" android:textSize="15sp" android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:layout_marginEnd="3dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_view_metric"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="7dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="Packed" android:textColor="@color/view_text_muted" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/view_mode_packed_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="0" android:textColor="@color/view_gold" android:textSize="15sp" android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_view_metric"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="7dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="Full Hand" android:textColor="@color/view_text_muted" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/view_mode_full_hand_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="0" android:textColor="@color/view_coral" android:textSize="15sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_view_hero_footer"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="9dp"
                            android:paddingBottom="10dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Point Value" android:textColor="@color/view_text_muted" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/view_mode_point_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="₹0.5" android:textColor="@color/view_violet_light" android:textSize="14sp" android:textStyle="bold" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="30dp"
                                android:background="@color/view_stroke" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Contribution" android:textColor="@color/view_text_muted" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/view_mode_contribution_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="10% · ₹94" android:textColor="@color/view_gold" android:textSize="14sp" android:textStyle="bold" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="30dp"
                                android:background="@color/view_stroke" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Total Players" android:textColor="@color/view_text_muted" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/view_mode_total_players" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="5" android:textColor="@color/view_text_primary" android:textSize="14sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Round scores, settlement, and administrative content scroll together. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/view_mode_settlement_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="24dp">

                <!-- Selected player's round scores -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/view_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/view_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/view_mode_round_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Player's Round Scores"
                                    android:textColor="@color/view_text_primary"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/view_mode_round_subtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Performance across all ten rounds"
                                    android:textColor="@color/view_text_muted"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/view_mode_round_total_container"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_view_metric"
                                android:gravity="center"
                                android:minWidth="82dp"
                                android:orientation="vertical"
                                android:paddingStart="12dp"
                                android:paddingTop="7dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="7dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total Score"
                                    android:textColor="@color/view_text_muted"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/view_mode_round_total_score"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="0"
                                    android:textColor="@color/view_gold"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/view_mode_round_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:padding="18dp"
                            android:text="Your account is not linked to a player in this game"
                            android:textColor="@color/view_text_muted"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/view_mode_round_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Settlement leaderboard -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settlement Overview" android:textColor="@color/view_text_primary" android:textSize="19sp" android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp" android:paddingBottom="7dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Receives" android:textColor="@color/view_mint" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:id="@+id/view_mode_receives_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_view_amount_receive" android:minWidth="24dp" android:gravity="center" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:text="0" android:textColor="@color/view_mint" android:textSize="9sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/view_mode_positive_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                        <TextView android:id="@+id/view_mode_positive_empty" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/bg_view_player_row" android:gravity="center" android:text="No positive balances" android:textColor="@color/view_text_muted" android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp" android:paddingBottom="7dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pays" android:textColor="@color/view_coral" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:id="@+id/view_mode_pays_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_view_amount_pay" android:minWidth="24dp" android:gravity="center" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:text="0" android:textColor="@color/view_coral" android:textSize="9sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/view_mode_negative_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                        <TextView android:id="@+id/view_mode_negative_empty" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/bg_view_player_row" android:gravity="center" android:text="No negative balances" android:textColor="@color/view_text_muted" android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/view_mode_hidden_settlements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="AMOUNTS HIDDEN" android:textColor="@color/view_text_muted" android:textSize="9sp" android:textStyle="bold" />
                    <LinearLayout android:id="@+id/view_mode_hidden_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>

                <!-- Admins can manage view requests without claiming edit access. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/view_mode_requests_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/view_surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/view_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/view_mode_requests_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/view_requests_section_title"
                                android:textColor="@color/view_text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/view_mode_requests_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_view_amount_pay"
                                android:gravity="center"
                                android:minWidth="24dp"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="3dp"
                                android:textColor="@color/view_coral"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/view_mode_requests_collapse_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/view_requests_section_title"
                                android:src="@drawable/ic_expand_more"
                                android:tint="@color/view_text_muted" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/view_mode_requests_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/view_mode_requests_empty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="@string/view_request_empty"
                                android:textColor="@color/view_text_muted"
                                android:textSize="12sp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/view_mode_requests_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </LinearLayout>
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

