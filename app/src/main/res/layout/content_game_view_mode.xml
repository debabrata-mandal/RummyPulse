<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_view_mode_screen"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

            <!-- View mode has its own app bar and never exposes edit-mode chrome. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/view_mode_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_back"
                    android:padding="13dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/view_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/view_mode_game_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Friday Night Rummy"
                        android:textColor="@color/view_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/view_mode_game_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="GAME · FNKV66TSI"
                        android:textColor="@color/view_text_muted"
                        android:textSize="10dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/view_mode_qr"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_view_action"
                    android:contentDescription="@string/cd_show_qr_code"
                    android:padding="11dp"
                    android:src="@drawable/ic_qr_code"
                    app:tint="@color/view_text_primary" />

                <ImageButton
                    android:id="@+id/view_mode_overflow"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_more_options"
                    android:padding="11dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/view_text_primary" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/view_mode_fixed_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <!--
                  Player performance header. One balance figure leads; everything else is caption
                  scale. Weight carries the hierarchy rather than boxes, so the only outlines on the
                  card are its own edge and a single hairline above the game-wide footer.

                  The rank rides along with the name instead of claiming a block of its own, and the
                  two supporting rows are centred columns so each figure sits under its caption.
                  Padding is kept tight because this card sits above the scroll and takes its height
                  from the round scores for the whole session. Captions are 10sp uppercase with wide
                  tracking, and every figure uses tabular digits so live updates never shift the
                  layout.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_view_hero_card"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/view_mode_player_initials"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/bg_view_hero_avatar"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/view_violet_light"
                                    android:textSize="11sp"
                                    tools:text="RK" />

                                <TextView
                                    android:id="@+id/view_mode_game_points_status"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="9dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/player_performance_title"
                                    android:textColor="@color/view_text_primary"
                                    android:textSize="14sp" />

                                <LinearLayout
                                    android:id="@+id/view_mode_rank_block"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:baselineAligned="true"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="6dp"
                                        android:letterSpacing="0.14"
                                        android:maxLines="1"
                                        android:text="@string/view_header_label_rank"
                                        android:textAllCaps="true"
                                        android:textColor="@color/view_text_muted"
                                        android:textSize="10sp" />

                                    <TextView
                                        android:id="@+id/view_mode_player_position"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFeatureSettings="tnum"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:textColor="@color/view_text_primary"
                                        android:textSize="16sp"
                                        tools:text="9 of 10" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/view_mode_personal_metrics"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:baselineAligned="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/view_mode_player_balance"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false"
                                    android:letterSpacing="-0.02"
                                    android:maxLines="1"
                                    android:textColor="@color/view_mint"
                                    android:textSize="34sp"
                                    android:textStyle="bold"
                                    app:autoSizeMaxTextSize="34sp"
                                    app:autoSizeMinTextSize="20sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform"
                                    tools:text="-203 GP" />

                                <TextView
                                    android:id="@+id/view_mode_balance_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:letterSpacing="0.14"
                                    android:maxLines="1"
                                    android:text="@string/view_header_label_balance"
                                    android:textAllCaps="true"
                                    android:textColor="@color/view_text_muted"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/view_mode_position_delta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/view_text_secondary"
                                android:textSize="12sp"
                                android:visibility="gone"
                                tools:text="Up 2 places this round"
                                tools:visibility="visible" />

                            <include
                                android:id="@+id/view_mode_round_indicator"
                                layout="@layout/view_round_indicator"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp" />

                            <LinearLayout
                                android:id="@+id/view_mode_player_stats"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.14" android:maxLines="1" android:text="@string/view_header_label_made" android:textAllCaps="true" android:textColor="@color/view_text_muted" android:textSize="10sp" />
                                    <TextView android:id="@+id/view_mode_made_game_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/view_mint" android:textSize="16sp" tools:text="0" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.14" android:maxLines="1" android:text="@string/view_header_label_packed" android:textAllCaps="true" android:textColor="@color/view_text_muted" android:textSize="10sp" />
                                    <TextView android:id="@+id/view_mode_packed_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/view_gold" android:textSize="16sp" tools:text="7" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.14" android:maxLines="1" android:text="@string/view_header_label_full_hand" android:textAllCaps="true" android:textColor="@color/view_text_muted" android:textSize="10sp" />
                                    <TextView android:id="@+id/view_mode_full_hand_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/view_coral" android:textSize="16sp" tools:text="0" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Game-wide setup. Same card, deliberately the quietest row in it. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_view_hero_card_footer"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingTop="9dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="10dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.14" android:maxLines="1" android:text="@string/view_header_label_gp_factor" android:textAllCaps="true" android:textColor="@color/view_text_muted" android:textSize="10sp" />
                                <TextView android:id="@+id/view_mode_game_point_factor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFeatureSettings="tnum" android:maxLines="1" android:textColor="@color/view_text_secondary" android:textSize="12sp" tools:text="0.5x" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.4"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.14" android:maxLines="1" android:text="@string/view_header_label_board" android:textAllCaps="true" android:textColor="@color/view_text_muted" android:textSize="10sp" />
                                <TextView android:id="@+id/view_mode_board_adjustment_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFeatureSettings="tnum" android:maxLines="1" android:textColor="@color/view_text_secondary" android:textSize="12sp" tools:text="10% - 84 GP" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.14" android:maxLines="1" android:text="@string/view_header_label_players" android:textAllCaps="true" android:textColor="@color/view_text_muted" android:textSize="10sp" />
                                <TextView android:id="@+id/view_mode_total_players" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFeatureSettings="tnum" android:maxLines="1" android:textColor="@color/view_text_secondary" android:textSize="12sp" tools:text="10" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Round scores, game_points, and administrative content scroll together. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/view_mode_game_points_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="24dp">

                <!-- Selected player's round scores -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/view_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/view_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/view_mode_round_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/players_round_scores_title"
                                    android:textColor="@color/view_text_primary"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/view_mode_round_subtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/players_round_scores_subtitle"
                                    android:textColor="@color/view_text_muted"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/view_mode_round_total_container"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_view_metric"
                                android:gravity="center"
                                android:minWidth="82dp"
                                android:orientation="vertical"
                                android:paddingStart="12dp"
                                android:paddingTop="7dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="7dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/standing_total_score"
                                    android:textColor="@color/view_text_muted"
                                    android:textSize="9dp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/view_mode_round_total_score"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    tools:text="0"
                                    android:textColor="@color/view_gold"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/view_mode_round_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:padding="18dp"
                            android:text="@string/account_not_linked_message"
                            android:textColor="@color/view_text_muted"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/view_mode_round_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Game_Points leaderboard -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="@string/game_points_overview_title"
                    android:textColor="@color/view_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp" android:paddingBottom="7dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/edit_game_points_direction_receives" android:textColor="@color/view_mint" android:textSize="10dp" android:textStyle="bold" />
                            <TextView android:id="@+id/view_mode_receives_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_view_amount_receive" android:minWidth="24dp" android:gravity="center" android:paddingHorizontal="6dp" android:paddingVertical="3dp" tools:text="0" android:textColor="@color/view_mint" android:textSize="9dp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/view_mode_positive_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                        <TextView android:id="@+id/view_mode_positive_empty" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/bg_view_player_row" android:gravity="center" android:text="@string/no_positive_balances" android:textColor="@color/view_text_muted" android:textSize="10dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp" android:paddingBottom="7dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/edit_game_points_direction_pays" android:textColor="@color/view_coral" android:textSize="10dp" android:textStyle="bold" />
                            <TextView android:id="@+id/view_mode_pays_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_view_amount_pay" android:minWidth="24dp" android:gravity="center" android:paddingHorizontal="6dp" android:paddingVertical="3dp" tools:text="0" android:textColor="@color/view_coral" android:textSize="9dp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/view_mode_negative_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                        <TextView android:id="@+id/view_mode_negative_empty" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/bg_view_player_row" android:gravity="center" android:text="@string/no_negative_balances" android:textColor="@color/view_text_muted" android:textSize="10dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/view_mode_hidden_game_points"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="@string/amounts_hidden_label" android:textColor="@color/view_text_muted" android:textSize="9dp" android:textStyle="bold" />
                    <LinearLayout android:id="@+id/view_mode_hidden_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>

                <!-- Admins can manage view requests without claiming edit access. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/view_mode_requests_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/view_surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/view_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/view_mode_requests_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/view_requests_section_title"
                                android:textColor="@color/view_text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/view_mode_requests_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_view_amount_pay"
                                android:gravity="center"
                                android:minWidth="24dp"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="3dp"
                                android:textColor="@color/view_coral"
                                android:textSize="10dp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/view_mode_requests_collapse_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/view_requests_section_title"
                                android:src="@drawable/ic_expand_more"
                                app:tint="@color/view_text_muted" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/view_mode_requests_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/view_mode_requests_empty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="@string/view_request_empty"
                                android:textColor="@color/view_text_muted"
                                android:textSize="12sp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/view_mode_requests_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </LinearLayout>
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
</LinearLayout>
