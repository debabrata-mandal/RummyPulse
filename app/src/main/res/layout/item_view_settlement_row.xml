<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_view_player_row"
    android:minHeight="104dp"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
            <TextView android:id="@+id/view_settlement_avatar" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:background="@drawable/bg_view_avatar" android:gravity="center" android:text="A" android:textColor="@color/view_violet_light" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/view_settlement_rank" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_view_rank" android:gravity="center" android:text="1" android:textColor="@color/view_text_primary" android:textSize="8sp" android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/view_settlement_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Player" android:textColor="@color/view_text_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/view_settlement_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="128 points" android:textColor="@color/view_text_muted" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/view_settlement_direction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Receives" android:textColor="@color/view_text_muted" android:textSize="8sp" android:textStyle="bold" />
        <TextView android:id="@+id/view_settlement_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_view_amount_receive" android:gravity="center" android:minWidth="72dp" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:text="+₹1,240" android:textColor="@color/view_mint" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
