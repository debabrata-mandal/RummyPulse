<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/bg_view_round_cell"
    android:padding="6dp">

    <TextView
        android:id="@+id/view_round_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_view_round_label"
        android:gravity="center"
        android:minWidth="24dp"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:text="R1"
        android:textColor="@color/view_text_secondary"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/view_round_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:text="25"
        android:textColor="@color/view_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />
</FrameLayout>
