<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_view_hero"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Identity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_ranking_detail_rank_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:background="@drawable/bg_ranking_avatar"
            tools:text="1" />

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_perf_avatar">

            <ImageView
                android:id="@+id/image_ranking_detail_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@string/dashboard_avatar_description"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_ranking_detail_avatar_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ranking_avatar"
                android:gravity="center"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="AD" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_ranking_detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/view_text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="Avijit Das" />

            <TextView
                android:id="@+id/text_ranking_detail_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/view_text_secondary"
                android:textSize="12sp"
                tools:text="Top 12% · 18 players ranked" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_ranking_detail_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_view_action"
            android:clickable="true"
            android:contentDescription="@string/dialog_close"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            app:tint="@color/view_text_secondary" />
    </LinearLayout>

    <!-- Period selector -->
    <LinearLayout
        android:id="@+id/ranking_detail_period_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_segmented_track"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/ranking_detail_segment_all_time"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/dashboard_period_all_time"
            android:textColor="@color/view_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ranking_detail_segment_this_month"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/dashboard_period_this_month"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ranking_detail_segment_last_month"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/dashboard_period_last_month"
            android:textColor="@color/view_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ranking_detail_segment_this_week"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/dashboard_period_this_week"
            android:textColor="@color/view_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_ranking_detail_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_ranking_detail_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="32dp"
                android:text="@string/player_ranking_detail_no_games"
                android:textColor="@color/view_text_muted"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/layout_ranking_detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Hero net -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_perf_hero"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/text_ranking_detail_hero_net"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/view_mint"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            tools:text="+1,240 GP" />

                        <TextView
                            android:id="@+id/text_ranking_detail_hero_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:letterSpacing="0.12"
                            android:textColor="@color/view_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="GAME POINTS · THIS MONTH" />

                        <TextView
                            android:id="@+id/text_ranking_detail_hero_rank"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_ranking_pill"
                            android:paddingStart="12dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/view_violet_light"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="#2 of 18" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Activity tiles -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tile_ranking_detail_games"
                        layout="@layout/item_ranking_detail_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tile_ranking_detail_wins"
                        layout="@layout/item_ranking_detail_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tile_ranking_detail_losses"
                        layout="@layout/item_ranking_detail_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tile_ranking_detail_win_rate"
                        layout="@layout/item_ranking_detail_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Rankings by metric -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#38111424"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/view_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/player_ranking_detail_rankings_section"
                            android:textColor="@color/accent_blue_light"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_ranking_detail_rank_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Game points breakdown -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_ranking_detail_points"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#38111424"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/view_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/player_ranking_detail_points_section"
                            android:textColor="@color/accent_blue_light"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_ranking_detail_point_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Leader comparison -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_ranking_detail_comparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    app:cardBackgroundColor="#38111424"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/view_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/player_ranking_detail_comparison_section"
                            android:textColor="@color/accent_blue_light"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_ranking_detail_comparison_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:id="@+id/layout_ranking_detail_share"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_perf_tile"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/player_ranking_detail_share_of_leader"
                                        android:textColor="@color/view_text_secondary"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/player_ranking_detail_share_hint"
                                        android:textColor="@color/view_text_muted"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/text_ranking_detail_share"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/view_violet_light"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="82%" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/ranking_detail_magnitude_track"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <View
                                    android:id="@+id/ranking_detail_magnitude_fill"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_ranking_pill" />

                                <View
                                    android:id="@+id/ranking_detail_magnitude_rest"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="0" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
