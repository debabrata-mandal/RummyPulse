<?xml version="1.0" encoding="utf-8"?>
<!--
  One pending view request. The avatar initial comes from the name already resolved for the row, so
  the identity reads at a glance without asking the directory for anything more. Approve and reject
  stay as the two labelled actions they were; only their density changes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <TextView
        android:id="@+id/view_request_avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_view_hero_avatar"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/view_violet_light"
        android:textSize="12sp"
        tools:text="AK" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_view_request_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/view_text_primary"
            android:textSize="14sp"
            tools:text="Asik K" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_view_request_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textSize="10sp"
                tools:text="Pending" />

            <TextView
                android:id="@+id/text_view_request_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/view_text_muted"
                android:textSize="11sp"
                tools:text="Requested 04:05 PM" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_view_request_approve"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="34dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/view_request_approve"
        android:textAllCaps="false"
        android:textColor="@color/view_mint"
        android:textSize="12sp"
        app:cornerRadius="17dp"
        app:rippleColor="#3300E676" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_view_request_reject"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="34dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/view_request_reject"
        android:textAllCaps="false"
        android:textColor="@color/view_coral"
        android:textSize="12sp"
        app:cornerRadius="17dp"
        app:rippleColor="#33FF1744" />

</LinearLayout>
