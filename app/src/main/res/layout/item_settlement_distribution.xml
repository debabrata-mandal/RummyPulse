<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="50dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="8dp">

    <View
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="@color/accent_blue" />

    <TextView
        android:id="@+id/text_distribution_recipient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        tools:text="to Priya" />

    <TextView
        android:id="@+id/text_distribution_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:textColor="@color/success_green"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="₹200.00" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkbox_distribution_paid"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:buttonTint="@color/accent_blue"
        android:contentDescription="@string/player_consolidation_mark_paid"
        app:useMaterialThemeColors="false" />

</LinearLayout>
