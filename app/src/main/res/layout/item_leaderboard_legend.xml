<?xml version="1.0" encoding="utf-8"?>
<!-- One legend cell, tying a donut slice colour back to a player. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/legend_cell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_leaderboard_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="9dp"
    android:paddingTop="7dp"
    android:paddingEnd="9dp"
    android:paddingBottom="7dp">

    <View
        android:id="@+id/legend_dot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:background="@drawable/bg_leaderboard_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/legend_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Player"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/legend_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="#1"
            android:textColor="@color/view_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
