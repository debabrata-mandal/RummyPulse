<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared round indicator for the edit and read-only game headers. The round is the single most
  important number on the screen, so it leads with a large numeral and a segment per round rather
  than a caption over a continuous bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/round_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/round_indicator_pill_live"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp">

            <View
                android:id="@+id/round_status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/round_indicator_dot_live" />

            <TextView
                android:id="@+id/round_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="@string/round_indicator_live"
                android:textColor="@color/view_violet_light"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/round_word_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="@string/round_indicator_label"
                android:textColor="@color/view_text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/round_current_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/view_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="2" />

            <TextView
                android:id="@+id/round_total_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/view_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="/10" />
        </LinearLayout>
    </LinearLayout>

    <com.example.rummypulse.ui.join.RoundSegmentBar
        android:id="@+id/round_segment_bar"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="6dp" />
</LinearLayout>
